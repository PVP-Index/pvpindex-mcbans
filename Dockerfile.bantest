FROM maven:3.9-eclipse-temurin-8-alpine AS build

WORKDIR /app

# Copy the entire project
COPY . /app/

# Build and cache dependencies
RUN mvn -B package -DskipTests

FROM eclipse-temurin:8-jre-alpine

WORKDIR /app

COPY --from=build /app /app

# Create a shell script to run the BanTest class
RUN echo '#!/bin/sh' > /app/run.sh && \
    echo '# Set default API key if not provided as environment variable' >> /app/run.sh && \
    echo 'if [ -z "$MCBANS_API_KEY" ]; then' >> /app/run.sh && \
    echo '  export MCBANS_API_KEY="test_api_key"' >> /app/run.sh && \
    echo 'fi' >> /app/run.sh && \
    echo '# Set default player name if not provided as environment variable' >> /app/run.sh && \
    echo 'if [ -z "$MCBANS_PLAYER_TO_BAN" ]; then' >> /app/run.sh && \
    echo '  export MCBANS_PLAYER_TO_BAN="test_player"' >> /app/run.sh && \
    echo 'fi' >> /app/run.sh && \
    echo 'cd /app && mvn -o exec:java -Dexec.mainClass=com.mcbans.test.BanTest' >> /app/run.sh && \
    chmod +x /app/run.sh

# Run the shell script
ENTRYPOINT ["/app/run.sh"]

# Default command line arguments (can be overridden)
CMD []
